# Copy to .env.local to override. All values are public build-time settings, not secrets.
# mock = closest sample payload from src/mocks, labeled MOCK DATA (default); live = FastAPI backend
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8000
# Chamber developer controls (Static placeholder / Unity WebGL / Standalone); also enabled with ?dev in the URL
VITE_CHAMBER_DEV_CONTROLS=false
# Default chamber view: webgl (default, Unity build served by StartWebGL.cmd; falls back to static if unreachable) or static
VITE_CHAMBER_VIEW=webgl
